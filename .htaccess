# ============================================
# Sistema SaaS Restaurante — .htaccess
# Autor: Reiner Jiménez (R.DEV)
# ============================================

Options -Indexes

# Bloquear carpetas de desarrollo, auditoria y despliegue que no son runtime.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:\.git|docs|tests|scripts|database|graphify-out)(?:/|$) - [F,L,NC]
    RewriteRule (?:^|/)[^/]+\.md$ - [F,L,NC]
</IfModule>

# Bloquear archivos ocultos de configuracion y control de versiones.
<FilesMatch "^\.(env(?:\..*)?|gitignore|gitattributes|gitmodules)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule mod_access_compat.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Proteger carpeta config/ de acceso directo
<FilesMatch "^(db\.php|config\.php|install\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule mod_access_compat.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Proteger archivos sensibles
<FilesMatch "\.(sql|ini|log|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule mod_access_compat.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Headers de seguridad
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self'"
</IfModule>

# Comprimir assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json
</IfModule>

# Cache de assets estáticos
<FilesMatch "\.(css|js|png|jpg|webp|ico|woff2)$">
    Header set Cache-Control "max-age=2592000, public"
</FilesMatch>

# UTF-8 por defecto
AddDefaultCharset UTF-8
