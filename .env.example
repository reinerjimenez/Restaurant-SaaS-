# ── Copia este archivo como .env y completa los valores reales ──
# El archivo .env NUNCA debe subirse al repositorio.

# ── Base de Datos ─────────────────────
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# ── URL Base (opcional) ───────────────
# Dejar vacío en localhost (se auto-detecta).
# En producción con dominio propio: BASE_URL=https://mi-dominio.com
BASE_URL=

# ── API de consulta DNI/RUC ───────────
# Obtén tu token en: https://apis.net.pe
APIS_NET_TOKEN=

